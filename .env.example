# --- General ---
NODE_ENV=development
PORT=3000

# --- Base de donnees ---
DATABASE_URL="mysql://user:password@localhost:3306/rhopenlabs"

# --- JWT ---
# Generer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Les deux secrets doivent etre differents, sinon un refresh token devient
# utilisable comme access token.
JWT_ACCESS_SECRET=changez-moi-secret-access-32-caracteres-minimum
JWT_REFRESH_SECRET=changez-moi-secret-refresh-32-caracteres-minimum
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- CORS ---
# Origines autorisees, separees par des virgules
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
