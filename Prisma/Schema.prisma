generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model user {
  idUser            Int               @id @default(autoincrement()) @db.UnsignedInt
  professionalEmail String            @unique(map: "professionalEmail") @db.VarChar(150)
  password          String            @db.VarChar(255)
  role              user_role         @default(Employer)
  createdAt         DateTime          @default(now())
  isActive          Boolean           @default(true)
  refreshToken      String?           @db.VarChar(255)
  updatedAt         DateTime          @updatedAt
  breakdowns        breakdown[]
  equipment         equipment[]
  assignments       logisticservice[]
  requests          request[]
  submissions       submission[]

  @@map("user")
}

model equipment {
  idEquipment   Int              @id @default(autoincrement()) @db.UnsignedInt
  description   String?          @db.VarChar(255)
  serialNumber  String?          @unique(map: "serialNumber") @db.VarChar(100)
  createdAt     DateTime         @default(now())
  idUser        Int?             @map("idUser") @db.UnsignedInt
  status        equipment_status @default(AVAILABLE)
  updatedAt     DateTime         @updatedAt
  breakdowns    breakdown[]
  licenses      license[]
  holder        user?            @relation(fields: [idUser], references: [idUser], onUpdate: Restrict, map: "FK_Equipment_User")

  @@index([idUser], map: "FK_Equipment_User")
  @@index([status], map: "IDX_Equipment_Status")
  @@map("equipment")
}

model breakdown {
  idBreakdown Int              @id @default(autoincrement()) @db.UnsignedInt
  label       String           @db.VarChar(100)
  description String?          @db.Text
  severity    breakdown_severity @default(Medium)
  createdAt   DateTime         @default(now())
  idEquipment Int?             @map("idEquipment") @db.UnsignedInt
  idUser      Int?             @map("idUser") @db.UnsignedInt
  resolvedAt  DateTime?
  status      breakdown_status @default(OPEN)
  updatedAt   DateTime         @updatedAt
  equipment   equipment?       @relation(fields: [idEquipment], references: [idEquipment], onUpdate: Restrict, map: "FK_Breakdown_Equipment")
  reporter    user?            @relation(fields: [idUser], references: [idUser], onUpdate: Restrict, map: "FK_Breakdown_User")

  @@index([idUser], map: "FK_Breakdown_User")
  @@index([idEquipment], map: "FK_Breakdown_Equipment")
  @@index([status], map: "IDX_Breakdown_Status")
  @@map("breakdown")
}

model request {
  idRequest    Int               @id @default(autoincrement()) @db.UnsignedInt
  description  String?           @db.Text
  creationDate DateTime          @default(now())
  createdAt    DateTime          @default(now())
  idUser       Int               @map("idUser") @db.UnsignedInt
  updatedAt    DateTime          @updatedAt
  assignments  logisticservice[]
  author       user              @relation(fields: [idUser], references: [idUser], onDelete: Cascade, onUpdate: Restrict, map: "FK_Request_User")
  submissions  submission[]

  @@index([idUser], map: "FK_Request_User")
  @@index([creationDate], map: "IDX_Request_CreationDate")
  @@map("request")
}

model logisticservice {
  idLogisticService Int      @id @default(autoincrement()) @db.UnsignedInt
  idRequest         Int      @map("idRequest") @db.UnsignedInt
  createdAt         DateTime @default(now())
  idLogistician     Int      @map("idLogistician") @db.UnsignedInt
  logistician       user     @relation(fields: [idLogistician], references: [idUser], onDelete: Cascade, onUpdate: Restrict, map: "FK_Assignment_Logistician")
  request           request  @relation(fields: [idRequest], references: [idRequest], onDelete: Cascade, onUpdate: Restrict, map: "FK_Assignment_Request")

  @@unique([idRequest, idLogistician], map: "UQ_Assignment_Request_Logistician")
  @@index([idLogistician], map: "FK_Assignment_Logistician")
  @@index([idRequest], map: "FK_ServiceLog_Demande")
  @@map("logisticservice")
}

model submission {
  idUser    Int      @map("idUser") @db.UnsignedInt
  idRequest Int      @map("idRequest") @db.UnsignedInt
  createdAt DateTime @default(now())
  request   request  @relation(fields: [idRequest], references: [idRequest], onDelete: Cascade, onUpdate: Restrict, map: "FK_Submission_Request")
  user      user     @relation(fields: [idUser], references: [idUser], onDelete: Cascade, onUpdate: Restrict, map: "FK_Submission_User")

  @@id([idUser, idRequest])
  @@index([idRequest], map: "FK_Soumettre_Demande")
  @@map("submission")
}

model license {
  idLicense     Int            @id @default(autoincrement()) @map("idLicense") @db.UnsignedInt
  licenseNumber String         @unique @map("licenseNumber") @db.VarChar(100)
  status        license_status @default(ACTIVE) @map("status")
  idEquipment   Int            @unique @map("idEquipment") @db.UnsignedInt
  createdAt     DateTime       @default(now()) @map("createdAt")
  updatedAt     DateTime       @updatedAt @map("updatedAt")
  equipment     equipment      @relation(fields: [idEquipment], references: [idEquipment], onDelete: Cascade, onUpdate: Restrict, map: "FK_License_Equipment")

  @@index([idEquipment], map: "FK_License_Equipment")
  @@index([status], map: "IDX_License_Status")
  @@map("license")
}

model prisma_migrations {
  id             String    @id @db.VarChar(36)
  checksum       String    @db.VarChar(64)
  finished_at    DateTime?
  migration_name String    @db.VarChar(255)
  logs           String?   @db.Text
  rolled_back_at DateTime?
  started_at     DateTime  @default(now())

  @@map("_prisma_migrations")
}

enum user_role {
  Administrator
  Director
  Manager
  Logistician
  Employer
}

enum equipment_status {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum breakdown_status {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum breakdown_severity {
  Low
  Medium
  High
  Critical
}

enum license_status {
  ACTIVE
  EXPIRED
  SUSPENDED
}
